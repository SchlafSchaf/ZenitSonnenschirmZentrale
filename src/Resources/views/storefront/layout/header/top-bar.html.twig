{% sw_extends '@Storefront/storefront/layout/header/top-bar.html.twig' %}

{# Top bar of the Zentrale: the four advantages of SW5 as yellow boxes (texts: snippets sche.header.usp*) instead of
   Gravity's marketing text slider; desktop only #}
{% block zen_layout_header_top_bar_marketing %}
    {% set scheUsps = [
        { text: 'sche.header.usp1', icon: null },
        { text: 'sche.header.usp2', icon: 'shield' },
        { text: 'sche.header.usp3', icon: null },
        { text: 'sche.header.usp4', icon: 'speech-bubble' }
    ] %}

    <ul class="sche-usps d-none d-lg-flex">
        {% for usp in scheUsps %}
            <li class="sche-usps__item">
                {% if usp.icon %}
                    {% sw_icon usp.icon style { size: 'xs', class: 'sche-usps__icon' } %}
                {% endif %}
                {{ usp.text|trans|sw_sanitize }}
            </li>
        {% endfor %}
    </ul>
{% endblock %}
