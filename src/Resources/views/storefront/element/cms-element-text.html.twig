{% sw_extends '@Storefront/storefront/element/cms-element-text.html.twig' %}

{# Placeholder [sche-marken] in a text element = brand logos block (storefront/sche/brand-logos.html.twig),
   maintained once in the theme and usable in every shopping world #}
{% block element_text_inner %}
    {% set content = element.data.content %}

    {# YouTube links with the class sche-video-link open in the video overlay (AjaxModal + ScheSw6Core route
       frontend.sche.video-modal) - Shopware strips data-* attributes from CMS texts, so they are added here #}
    {% if 'sche-video-link' in content %}
        {% set scheVideoUrl = path('frontend.sche.video-modal', { videoId: 'xxxxxxxxxxx' })|replace({ 'xxxxxxxxxxx': '$1' }) %}
        {% set content = content|preg_replace(
            '#<a class="sche-video-link" href="https://www\\.youtube\\.com/watch\\?v=([A-Za-z0-9_-]{11})"#',
            '<a class="sche-video-link" href="https://www.youtube.com/watch?v=$1" data-ajax-modal="true" data-url="' ~ scheVideoUrl ~ '" data-modal-class="sche-video-modal-dialog"'
        ) %}
    {% endif %}

    {% if '[sche-marken]' in content %}
        {% set brandLogos %}
            {% sw_include '@Storefront/storefront/sche/brand-logos.html.twig' %}
        {% endset %}
        {% set content = content|replace({'<p>[sche-marken]</p>': brandLogos, '[sche-marken]': brandLogos}) %}
    {% endif %}

    {# Category text (mapped category.description, layout "Sonnenschirm-Zentrale | Kategorie"): on phones only the
       first paragraph with text shows, the rest opens with "mehr erfahren" - like the texts of the home page #}
    {% set scheFirst = '' %}
    {% set scheRest = '' %}
    {% if element.config.content.value == 'category.description' %}
        {% set scheChunks = content|split('</p>') %}
        {% set scheCount = 0 %}
        {% for chunk in scheChunks %}
            {% if scheCount == 0 %}
                {% set scheFirst = scheFirst ~ chunk ~ '</p>' %}
                {% if ((chunk|split('<p')|last)|split('>', 2)|last)|striptags matches '/[[:alnum:]]/u' %}
                    {% set scheCount = loop.index %}
                {% endif %}
            {% endif %}
        {% endfor %}
        {% set scheRest = scheCount > 0 ? scheChunks|slice(scheCount)|join('</p>') : '' %}
    {% endif %}

    {% if scheRest|striptags matches '/[[:alnum:]]/u' %}
        {% set scheCollapseId = 'sche-collapse-' ~ element.id %}

        <div class="sche-collapse-mobile-only sche-category-text">
            {{ scheFirst|raw }}

            <div class="collapse sche-category-text__more" id="{{ scheCollapseId }}">
                {{ scheRest|raw }}
            </div>

            <button class="btn btn-link btn-md sche-collapse-toggle sche-category-text__toggle"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#{{ scheCollapseId }}"
                    aria-expanded="false"
                    aria-controls="{{ scheCollapseId }}">
                <span class="sche-collapse-toggle__open">{{ 'sche.cms.collapseOpen'|trans|sw_sanitize }}</span>
                <span class="sche-collapse-toggle__close">{{ 'sche.cms.collapseClose'|trans|sw_sanitize }}</span>
                <span class="icon icon-default">
                    {{ source('@Storefront/assets/icon/default/arrow-head-down.svg', ignore_missing = true)|sw_icon_cache|raw }}
                </span>
            </button>
        </div>
    {% else %}
        {{ content|raw }}
    {% endif %}
{% endblock %}

{# Button of the collapsed text content (RHWeb CMS Elements): shows the configured button text while
   collapsed and "Text einklappen" (snippet sche.cms.collapseClose) while expanded #}
{% block rhweb_element_text_collapse_button %}
    {% set buttonClasses = [
        'btn',
        'btn-' ~ (config.btnType.value != 'link' and config.btnOutline.value ? 'outline-' : '') ~ config.btnType.value,
        'btn-' ~ config.btnSize.value,
        config.btnBlock.value ? 'btn-block',
        'rhweb-button',
        'sche-collapse-toggle'
    ] %}

    <button class="{{ buttonClasses|filter(c => c)|join(' ') }}"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#{{ collapseIdElement }}"
            aria-expanded="false"
            aria-controls="{{ collapseIdElement }}">
        <span class="sche-collapse-toggle__open">{{ config.btnText.value }}</span>
        <span class="sche-collapse-toggle__close">{{ 'sche.cms.collapseClose'|trans|sw_sanitize }}</span>
        <span class="icon icon-default">
            {{ source('@Storefront/assets/icon/default/arrow-head-down.svg', ignore_missing = true)|sw_icon_cache|raw }}
        </span>
    </button>
{% endblock %}
